# Strava App credentials (get these from https://www.strava.com/settings/api)
# These are set by the app owner once — users log in with their own Strava accounts
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# Perplexity API key (for AI coaching tab)
PERPLEXITY_API_KEY=your_perplexity_api_key

# OAuth redirect URI — set to your deployed app URL in production
# Leave as default for local development
# REDIRECT_URI=https://yourapp.streamlit.app

# SQLite database file path (default: running.db in project root)
# DB_FILE=running.db
